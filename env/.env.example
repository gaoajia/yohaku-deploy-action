# 使用 act 在本地执行 GitHub Actions 所需的 Secrets。
# 复制为 .env 并填写所有必填值。请勿提交 .env。

############################
# 工作流配置
############################
# 构建源码仓库，须与 GH_PAT 有权限访问的仓库一致
SOURCE_REPO=owner/Yohaku
# 一般留空用默认值；结构不同或者部署旧版时调整
STANDALONE_SUBPATH= 
BUILD_COMMAND=
HASH_FILE=
# 服务器部署目录；默认值为 $HOME/yohaku，运行时环境文件须为 BASE_DIR/.env。
BASE_DIR=


############################
# CI 构建配置
############################
BASE_URL=https://example.com
NEXT_PUBLIC_API_URL=${BASE_URL}/api/v3
NEXT_PUBLIC_GATEWAY_URL=${BASE_URL}


############################
# 连接配置
############################
# 用于读取 SOURCE_REPO；在线工作流使用自动生成的 GITHUB_TOKEN 回写当前仓库；
# 本地调试时这个凭证需要同时有SOURCE_REPO和当前仓库的访问权限
GH_PAT=
# SSH_PROXY 留空为普通 SSH，支持声明为 cloudflared 时通过 Cloudflare Access建立连接。
SSH_PROXY=
# 在当前网络环境下可达的服务器地址；建议直接使用公网可达的地址。
HOST=ssh.example.com
USER=deploy
PORT=22
# 使用 PASSWORD 时请保持 KEY 为空。使用 SSH 私钥时，可以直接写入多行私钥内容;
# 或者用shell读取文件内容，如在 pwsh 中：-s KEY="$(Get-Content -Raw <私钥文件路径>)"。
PASSWORD=
KEY=
# 仅 SSH_PROXY=cloudflared 时需要配置以下 Service Token。
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=


############################
# 其它配置
############################
# API 限流时的重试配置
BUILD_RATE_LIMIT_RETRIES=3
BUILD_RATE_LIMIT_DELAY=60

# 可选的部署后 Shell 命令
AFTER_DEPLOY_SCRIPT=

# 可选：保留最新的构建目录数；留空则保留全部
BUILD_RETENTION_COUNT=
